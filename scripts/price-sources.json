{
  "version": 3,
  "sources": [],
  "templates": {
    "enchantedTicketSpice": {
      "parkGroup": "Enchanted Parks",
      "method": "GET",
      "headers": {
        "accept": "text/html,application/xhtml+xml,application/xml;q=0.9,*/*;q=0.8",
        "accept-language": "en-US,en;q=0.9",
        "cache-control": "no-cache",
        "pragma": "no-cache",
        "upgrade-insecure-requests": "1",
        "user-agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/126.0.0.0 Safari/537.36"
      },
      "url": "https://{ticketspiceHost}.ticketspice.com/admission-2026",
      "extract": {
        "type": "regex",
        "pattern": "{passLabelRegex}[\\s\\S]{0,6000}?(?:\\$|&#36;|&dollar;)\\s*([0-9]+\\.[0-9]{2})[\\s\\S]{0,400}?\\(\\s*(?:\\$|&#36;|&dollar;)"
      }
    },
    "sixFlagsAccessoBootstrap": {
      "method": "GET",
      "headers": {
        "accept": "application/json, text/plain, */*",
        "origin": "https://{storeHost}",
        "referer": "https://{storeHost}/"
      },
      "url": "https://{apiHost}/static-api/bootstrap?m={merchant}",
      "extract": {
        "type": "json-deep-search",
        "match": { "path": ["name", "label"], "includes": "{passLabel}" },
        "value": { "path": "CT" }
      }
    }
  },
  "generatedSources": [
