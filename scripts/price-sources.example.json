{
  "portalHostTemplates": {
    "cf": "cf-{parkCode}.buy",
    "sf": "sf-gc-{parkCode}.store"
  },
  "sources": {
    "accesso-portal": {
      "Season Passes": {
        "link": "sixflags.com/packageList/navItem/Season%20Passes",
        "Gold": {
          "seasonPassType": "GW",
          "target": "price",
          "jsonPaths": [
            "price_label_override"
          ],
          "portalHosts": {
            "cf": {
              "parks": {
                "example": {
                  "park": "Park Name",
                  "currencySymbol": "$",
                  "priceMatchers": [
                    {
                      "pattern": "Sale Price\\s*\\$([0-9]+(?:\\.[0-9]{2})?)",
                      "flags": "i",
                      "group": 1
                    }
                  ]
                },
                "example2": {
                  "park": "Another Park",
                  "currencySymbol": "$"
                },
                "example4": {
                  "park": "Fourth Park",
                  "currencySymbol": "$"
                }
              }
            },
            "sf": {
              "parks": {
                "example3": {
                  "park": "Third Park",
                  "currencySymbol": "$"
                },
                "example5": {
                  "park": "Fifth Park",
                  "currencySymbol": "$"
                }
              }
            }
          }
        }
      },
      "Memberships": {
        "link": "sixflags.com/packageList/navItem/Memberships",
        "Gold Membership": {
          "seasonPassType": "GW",
          "target": "pricing.monthly",
          "jsonPaths": [
            "CT.0.payment_plan_amount"
          ],
          "portalHosts": {
            "cf": {
              "parks": {
                "example": {
                  "park": "Park Name",
                  "currencySymbol": "$"
                }
              }
            }
          }
        }
      }
    }
  }
}
