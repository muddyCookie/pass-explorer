{
  "version": 2,
  "sources": [
    {
      "park": "Canada's Wonderland",
      "passType": "Gold",
      "currency": "CAD",
      "url": "https://example.com",
      "method": "GET",
      "extract": {
        "type": "regex",
        "pattern": "\\\"gold\\\"\\s*:\\s*\\{[^}]*?\\\"price\\\"\\s*:\\s*\\\"(\\$[0-9,.]+)\\\""
      }
    },
    {
      "park": "Michigan's Adventure",
      "passType": "Hero",
      "currency": "USD",
      "url": "https://michigans-adventure.ticketspice.com/admission-2026",
      "method": "GET",
      "headers": {
        "accept": "text/html,application/xhtml+xml,application/xml;q=0.9,*/*;q=0.8",
        "accept-language": "en-US,en;q=0.9",
        "user-agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/124.0.0.0 Safari/537.36"
      },
      "extract": {
        "type": "regex",
        "pattern": "Enchanted Hero Pass[\\s\\S]{0,800}?\\$\\s*([0-9]+\\.[0-9]{2})"
      }
    }
  ],
  "templates": {
    "sixFlagsAccessoBootstrap": {
      "method": "GET",
      "headers": {
        "accept": "application/json, text/plain, */*",
        "origin": "https://{storeHost}",
        "referer": "https://{storeHost}/"
      },
      "url": "https://ecomm.api.sf.accessoticketing.com/static-api/bootstrap?m={merchant}",
      "extract": {
        "type": "json-deep-search",
        "match": { "path": ["name", "label"], "includes": "{passLabel}" },
        "value": { "path": "CT" }
      }
    }
  },
  "generatedSources": [
    {
      "template": "sixFlagsAccessoBootstrap",
      "defaults": {
        "currency": "USD"
      },
      "parks": [
        {
          "park": "Six Flags Discovery Kingdom",
          "merchant": "SF-GC-DK",
          "storeHost": "sf-gc-dk.store.sixflags.com"
        },
        {
          "park": "Six Flags Magic Mountain",
          "merchant": "SF-MM",
          "storeHost": "sf-mm.store.sixflags.com"
        }
      ],
      "passes": [
        { "passType": "Gold", "passLabel": "2026 Gold Pass" },
        { "passType": "Prestige", "passLabel": "2026 Prestige Pass" }
      ]
    }
  ]
}
